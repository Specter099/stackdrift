{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/cfn_post_edit.py"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(cfn-lint*)",
      "Bash(yamllint*)"
    ]
  }
}
